---
import T from './T.astro';
import { site } from '../data/site';
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="#top" class="nav-brand">
      <span class="dot" aria-hidden="true"></span>
      <T en={site.name.en} cn={site.name.cn} tw={site.name.tw} />
    </a>

    <div class="nav-links">
      <a href="#about"><T en="About" cn="关于" tw="關於" /></a>
      <a href="#experience"><T en="Experience" cn="经历" tw="經歷" /></a>
      <a href="/blog/"><T en="Blog" cn="博客" tw="網誌" /></a>
      <a href="#projects"><T en="Projects" cn="项目" tw="項目" /></a>
    </div>

    <div class="nav-controls">
      <div class="lang" role="group" aria-label="Language / 语言">
        <button type="button" data-set-lang="en" aria-label="English">EN</button>
        <button type="button" data-set-lang="zh-CN" aria-label="简体中文">简</button>
        <button type="button" data-set-lang="zh-TW" aria-label="繁體中文">繁</button>
      </div>
      <button
        type="button"
        class="theme-btn"
        aria-label="Toggle light / dark mode"
        title="Toggle theme"
      >
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>
