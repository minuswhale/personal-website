---
import T from './T.astro';
import Section from './Section.astro';
import { hobbies } from '../data/site';
---

<Section
  id="projects"
  num="03"
  en="Hobbies"
  cn="爱好"
  tw="愛好"
  count={`${hobbies.length}`}
>
  <div class="rows">
    {
      hobbies.map((hobby, i) => (
        <div class="row">
          <div class="meta">
            {String(i + 1).padStart(2, '0')} / {String(hobbies.length).padStart(2, '0')}
          </div>
          <div class="body">
            <h3><T en={hobby.name.en} cn={hobby.name.cn} tw={hobby.name.tw} /></h3>
            {hobby.note && (
              <p>
                <T en={hobby.note.en} cn={hobby.note.cn} tw={hobby.note.tw} />
              </p>
            )}
          </div>
        </div>
      ))
    }
  </div>
</Section>
