---
import T from './T.astro';

interface Props {
  id: string;
  num: string;
  en: string;
  cn: string;
  tw: string;
  count?: string;
}
const { id, num, en, cn, tw, count } = Astro.props;
---

<section class="section" id={id}>
  <div class="container">
    <header class="section-head">
      <span class="num">{num}</span>
      <h2><T en={en} cn={cn} tw={tw} /></h2>
      <span class="rule" aria-hidden="true"></span>
      {count && <span class="count">{count}</span>}
    </header>
    <slot />
  </div>
</section>
